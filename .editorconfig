# =============================================================================
# EditorConfig - keeps formatting identical on every machine/editor.
# Editors that support this (IntelliJ, VS Code, Eclipse, Vim...) apply it
# automatically. It prevents noisy "reformat" diffs in a shared repository.
# =============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{*.yml,*.yaml}]
indent_size = 2

[{*.json,*.md}]
indent_size = 2
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.{html,css,js}]
indent_size = 2

[*.bat]
end_of_line = crlf
