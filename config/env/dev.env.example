# =============================================================================
# Mini SOC Dashboard - example environment file for LOCAL DEVELOPMENT
# -----------------------------------------------------------------------------
# HOW TO USE
#   Linux / macOS :  cp config/env/dev.env.example config/env/dev.env
#                    set -a; source config/env/dev.env; set +a
#   Windows PS    :  Copy-Item config/env/dev.env.example config/env/dev.env
#                    Get-Content config/env/dev.env | ForEach-Object {
#                      if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                        [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#
# IMPORTANT
#   * config/env/*.env is git-ignored. NEVER commit the real file.
#   * Only this *.example template is tracked, and it must never contain a real
#     password (that is why the value below is obviously fake).
# =============================================================================

# ------------------------------------------------------------------ Database
DB_URL=jdbc:postgresql://localhost:5432/minisoc_db
DB_USERNAME=minisoc
DB_PASSWORD=change-me-before-use

# ------------------------------------------------------------------- Profiles
# dev  = SQL logging, template cache off, Attack Simulator available
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------- Feature switches
APP_SIMULATOR_ENABLED=true

# ------------------------------------------------- Bootstrap ADMIN (Phase 3)
# Creates the FIRST administrator on startup - but only if that username does
# not exist yet, and the password is never written to the log. Leave the
# username/password empty (or comment all four lines out) if you do not want a
# bootstrap account: an empty username means "nothing to do".
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_FULL_NAME=
